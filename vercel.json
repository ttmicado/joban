{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/api/:path((?!handler$).*)",
      "destination": "/api/handler?__path=/api/:path"
    },
    {
      "source": "/ics/:file",
      "destination": "/api/handler?__path=/ics/:file"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
